<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LovePlaceApp.ViewModels"
             x:Class="LovePlaceApp.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Login">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Love Places" FontSize="30" FontAttributes="Bold" />
            <Label Text="Accedi per entrare nel tuo mondo condiviso." FontSize="14" />

            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

            <Label Text="{Binding HelperMessage}" FontSize="12" TextColor="#666666" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsBusy}">
                <ActivityIndicator IsRunning="{Binding IsBusy}" />
                <Label Text="Accesso in corso..." VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button Text="Accedi" Command="{Binding LoginCommand}" />
            <Button Text="Registrati" Command="{Binding GoToRegisterCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

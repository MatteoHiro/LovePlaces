<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LovePlaceApp.ViewModels"
             x:Class="LovePlaceApp.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Impostazioni">

    <VerticalStackLayout Padding="24" Spacing="10">
        <Label Text="Account" FontSize="24" FontAttributes="Bold" />
        <Button Text="Logout" Command="{Binding LogoutCommand}" />
    </VerticalStackLayout>

</ContentPage>

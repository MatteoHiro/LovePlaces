<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LovePlaceApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:LovePlaceApp.Pages"
    Title="Love Places">

    <ShellContent
        Title="Login"
        Route="login"
        ContentTemplate="{DataTemplate pages:LoginPage}" />

    <ShellContent
        Title="Connessioni"
        Route="connections"
        ContentTemplate="{DataTemplate pages:ConnectionsListPage}" />

</Shell>
